@page
@model NedumkandomPublicLibrary.Pages.IndexModel
@{
    ViewData["Title"] = $"{Model.Library.Name} | {Model.Library.NameEnglish}";
}

<div class="homepage-wrapper">
    
    <!-- ===================================================================
        1. HERO SECTION (Clean, Aesthetic Malayalam Banner)
        =================================================================== -->
    <section id="home-section" class="hero-section">
        <div class="hero-container">
            
            <!-- Official Logo Display -->
            <div class="flex-center">
                <div class="hero-logo-card">
                    <img src="~/images/logo.png"
                         alt="@Model.Library.Name ലോഗോ"
                         width="96"
                         height="96"
                         class="hero-logo-img" />
                </div>
            </div>

            <!-- Tagline Badge -->
            <div class="hero-tagline-badge">
                <svg class="w-4 h-4 text-amber" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
                </svg>
                <span>@Model.Library.Tagline</span>
            </div>

            <div class="space-y-3">
                <h1 class="hero-title">
                    @Model.Library.Name
                </h1>
                <p class="hero-description">
                    നെടുങ്കണ്ടത്തിന്റെ വായനാ സംസ്കാരത്തെ കൂടുതൽ ശക്തിപ്പെടുത്തുകയും, പുതിയ തലമുറയെ അറിവിലേക്കും സാഹിത്യത്തിലേക്കും ചിന്തയിലേക്കും നയിക്കുകയും ചെയ്യുന്ന ജനകീയ പൊതുഗ്രന്ഥശാല.
                </p>
            </div>

            <!-- Highlights -->
            <div class="hero-highlights-row">
                <div class="hero-highlight-pill">
                    <svg class="w-4 h-4 text-amber-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                    </svg>
                    <span>വിപുലമായ പുസ്തകശേഖരം</span>
                </div>
                <div class="hero-highlight-pill">
                    <svg class="w-4 h-4 text-amber-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                    <span>എല്ലാവർക്കുമായി തുറന്ന അംഗത്വം</span>
                </div>
                <div class="hero-highlight-pill">
                    <svg class="w-4 h-4 text-amber-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
                    </svg>
                    <span>ശാന്തമായ വായനാമുറി</span>
                </div>
            </div>

            <!-- Primary CTA Button -->
            <div class="pt-2">
                <a href="/#apply-form" class="hero-cta-btn">
                    <span>അംഗത്വത്തിന് അപേക്ഷിക്കുക</span>
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <polyline points="19 12 12 19 5 12"/>
                    </svg>
                </a>
            </div>

        </div>
    </section>

    <!-- ===================================================================
        VISION STATEMENT
        =================================================================== -->
    <section class="content-section text-center">
        <div class="vision-card">
            <div class="vision-badge">
                ഞങ്ങളുടെ ദർശനം
            </div>
            <div class="vision-quote-large">“@Model.Library.Vision”</div>
            <p class="vision-fulltext">
                @Model.Library.VisionFull
            </p>
        </div>
    </section>

    <!-- ===================================================================
        SECTION 1 – ഞങ്ങളെക്കുറിച്ച് (About the Library)
        =================================================================== -->
    <section class="content-section">
        <div class="white-card">
            <h2 class="section-heading">
                ഞങ്ങളെക്കുറിച്ച്
            </h2>
            <p class="section-paragraph">
                നെടുങ്കണ്ടം പ്രദേശത്തെ വായനക്കാരെയും വിദ്യാർത്ഥികളെയും കുട്ടികളെയും കുടുംബങ്ങളെയും ഒരുമിപ്പിക്കുന്ന ഒരു ജനകീയ പൊതുഗ്രന്ഥശാലയാണ് നെടുങ്കണ്ടം പബ്ലിക് ലൈബ്രറി. വായനയെ പ്രോത്സാഹിപ്പിക്കുകയും പഠനത്തിനും ചിന്തയ്ക്കും ആരോഗ്യകരമായ ചർച്ചകൾക്കും സാംസ്കാരിക വളർച്ചയ്ക്കും സൗകര്യമൊരുക്കുകയും ചെയ്യുക എന്നതാണ് ഈ ലൈബ്രറിയുടെ ലക്ഷ്യം. അറിവ് സമൂഹത്തിലെ ഓരോ വ്യക്തിയിലേക്കും യാതൊരു വേർതിരിവുമില്ലാതെ ലഭ്യമാക്കാൻ ഞങ്ങൾ പ്രതിജ്ഞാബദ്ധരാണ്.
            </p>
        </div>
    </section>

    <!-- ===================================================================
        SECTION 2 – ഞങ്ങളുടെ ലക്ഷ്യങ്ങൾ (Our Goals)
        =================================================================== -->
    <section class="content-section">
        <div class="white-card">
            <h2 class="section-heading">
                ഞങ്ങളുടെ ലക്ഷ്യങ്ങൾ
            </h2>
            
            <div class="two-col-grid">
                @foreach (var goal in new[] {
                    "വായനാശീലം വളർത്തുക",
                    "വിദ്യാർത്ഥികൾക്ക് പഠനസഹായം നൽകുക",
                    "കുടുംബ വായന പ്രോത്സാഹിപ്പിക്കുക",
                    "കുട്ടികളിൽ വായനയോടുള്ള താൽപര്യം വളർത്തുക",
                    "ഡിജിറ്റൽ അറിവിലേക്ക് പ്രവേശനം നൽകുക",
                    "പത്രങ്ങളും ആനുകാലികങ്ങളും ലഭ്യമാക്കുക",
                    "സാഹിത്യ-സാംസ്കാരിക പരിപാടികൾ സംഘടിപ്പിക്കുക",
                    "എല്ലാവർക്കും അറിവിന്റെ അവസരം ഒരുക്കുക"
                })
                {
                    <div class="goal-item-card">
                        <svg class="w-5 h-5 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                            <polyline points="22 4 12 14.01 9 11.01"/>
                        </svg>
                        <span class="font-bold text-slate-800">@goal</span>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ===================================================================
        SECTION 3 – ഞങ്ങളുടെ ശേഖരം (Our Collection)
        =================================================================== -->
    <section class="content-section">
        <div class="white-card">
            <h2 class="section-heading">
                ഞങ്ങളുടെ ശേഖരം
            </h2>

            <div class="two-col-grid">
                
                <!-- Malayalam Collection -->
                <div class="collection-box malayalam-box">
                    <h3 class="collection-header text-emerald-dark">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                        </svg>
                        <span>മലയാളം പുസ്തക വിഭാഗങ്ങൾ</span>
                    </h3>
                    <ul class="category-bullet-grid">
                        <li>നോവൽ</li>
                        <li>ചെറുകഥ</li>
                        <li>കവിത</li>
                        <li>ജീവചരിത്രം</li>
                        <li>ആത്മകഥ</li>
                        <li>ചരിത്രം</li>
                        <li>ശാസ്ത്രം</li>
                        <li>പൊതുവിജ്ഞാനം</li>
                        <li>ആരോഗ്യം</li>
                        <li>കൃഷി</li>
                        <li>മതം & തത്വചിന്ത</li>
                        <li>കുട്ടികളുടെ സാഹിത്യം</li>
                    </ul>
                </div>

                <!-- English Collection -->
                <div class="collection-box english-box">
                    <h3 class="collection-header text-slate-900">
                        <svg class="w-5 h-5 text-amber-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
                        </svg>
                        <span>English Books</span>
                    </h3>
                    <ul class="category-bullet-grid">
                        <li>Fiction</li>
                        <li>Non-fiction</li>
                        <li>Biography</li>
                        <li>History</li>
                        <li>Science</li>
                        <li>Reference</li>
                        <li>Children's Books</li>
                    </ul>
                </div>

            </div>

            <!-- Special Sections -->
            <div class="pt-2">
                <h4 class="font-bold text-sm text-slate-900 mb-3">
                    ലൈബ്രറിയിലെ മറ്റ് പ്രത്യേക വിഭാഗങ്ങൾ:
                </h4>
                <div class="three-col-grid">
                    @foreach (var sec in new[] {
                        "കുട്ടികളുടെ കോർണർ",
                        "യുവജന വിഭാഗം",
                        "മത്സരപരീക്ഷ വിഭാഗം",
                        "റഫറൻസ് വിഭാഗം",
                        "പത്ര-ആനുകാലിക വിഭാഗം",
                        "ഡിജിറ്റൽ വിഭവങ്ങൾ"
                    })
                    {
                        <div class="special-section-pill">
                            @sec
                        </div>
                    }
                </div>
            </div>

        </div>
    </section>

    <!-- ===================================================================
        SECTION 4 – ലൈബ്രറി സേവനങ്ങൾ (Library Services)
        =================================================================== -->
    <section class="content-section">
        <div class="white-card">
            <h2 class="section-heading">
                ലൈബ്രറി സേവനങ്ങൾ
            </h2>

            <div class="two-col-grid">
                @foreach (var service in new[] {
                    "പുസ്തകങ്ങൾ വായിക്കാം",
                    "പുസ്തകങ്ങൾ വീട്ടിലേക്ക് കൊണ്ടുപോകാം",
                    "റഫറൻസ് പുസ്തകങ്ങൾ ഉപയോഗിക്കാം",
                    "പത്രങ്ങളും മാസികകളും വായിക്കാം",
                    "വിദ്യാർത്ഥികൾക്ക് പഠനസൗകര്യം ലഭിക്കും",
                    "കുട്ടികൾക്കായുള്ള വായനാ പരിപാടികൾ",
                    "സാഹിത്യ-സാംസ്കാരിക പരിപാടികളിൽ പങ്കെടുക്കാം"
                })
                {
                    <div class="service-item-card">
                        <span class="service-dot"></span>
                        <span class="font-bold text-slate-800">@service</span>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ===================================================================
        SECTION 5 – കുട്ടികൾക്കും വിദ്യാർത്ഥികൾക്കും (For Children & Students)
        =================================================================== -->
    <section class="content-section">
        <div class="white-card">
            <div class="section-header-icon-row">
                <svg class="w-7 h-7 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                    <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                </svg>
                <h2 class="section-heading-inline">
                    കുട്ടികൾക്കും വിദ്യാർത്ഥികൾക്കും
                </h2>
            </div>

            <p class="section-paragraph">
                കുട്ടികളുടെയും വിദ്യാർത്ഥികളുടെയും ബൗദ്ധിക വളർച്ചയ്ക്ക് ലൈബ്രറി പ്രത്യേക പ്രാധാന്യം നൽകുന്നു. കഥാപുസ്തകങ്ങൾ, ശാസ്ത്ര പുസ്തകങ്ങൾ, മത്സരപരീക്ഷാ സഹായികൾ, ആനുകാലിക വിവരങ്ങൾ, കരിയർ ഗൈഡൻസ് സൗകര്യങ്ങൾ എന്നിവയോടൊപ്പം ശാന്തമായ പഠനാന്തരീക്ഷവും ഇവിടെ ഒരുക്കിയിട്ടുണ്ട്.
            </p>

            <div class="pt-2">
                <h4 class="font-bold text-sm text-slate-900 mb-3">
                    കുട്ടികൾക്കായുള്ള പ്രവർത്തനങ്ങൾ:
                </h4>
                <div class="three-col-grid">
                    @foreach (var act in new[] {
                        "കഥപറച്ചിൽ",
                        "ചിത്രരചന",
                        "വായനാ മത്സരം",
                        "ക്വിസ്",
                        "നാടകം",
                        "പ്രസംഗ മത്സരം"
                    })
                    {
                        <div class="activity-pill">
                            @act
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- ===================================================================
        SECTION 6 – അംഗമാകാൻ ആരെല്ലാം? (Who Can Become a Member?)
        =================================================================== -->
    <section class="content-section">
        <div class="membership-info-box">
            <div class="section-header-icon-row border-b border-emerald-200 pb-3">
                <svg class="w-7 h-7 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                </svg>
                <h2 class="section-heading-inline">
                    അംഗമാകാൻ ആരെല്ലാം?
                </h2>
            </div>

            <p class="text-sm sm:text-base text-slate-800 font-semibold">
                നെടുങ്കണ്ടം പബ്ലിക് ലൈബ്രറിയിലെ അംഗത്വം എല്ലാവർക്കുമായി തുറന്നിരിക്കുന്നു:
            </p>

            <div class="three-col-grid">
                @foreach (var cat in new[] {
                    "കുട്ടികൾ",
                    "വിദ്യാർത്ഥികൾ",
                    "യുവാക്കൾ",
                    "മുതിർന്നവർ",
                    "അധ്യാപകർ",
                    "ജീവനക്കാർ",
                    "വീട്ടമ്മമാർ",
                    "മുതിർന്ന പൗരന്മാർ",
                    "വായനയിൽ താൽപര്യമുള്ള എല്ലാവരും"
                })
                {
                    <div class="membership-category-card">
                        @cat
                    </div>
                }
            </div>

            <div class="pt-4 text-center border-t border-emerald-200">
                <p class="text-base sm:text-lg font-extrabold text-primary mb-3">
                    താഴെയുള്ള അപേക്ഷാ ഫോം പൂരിപ്പിച്ച് അംഗമാകാം.
                </p>
                <a href="/#apply-form" class="btn-goto-form">
                    <span>അപേക്ഷാ ഫോമിലേക്ക് പോകാം</span>
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <polyline points="19 12 12 19 5 12"/>
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- ===================================================================
        SECTION 7 – അപേക്ഷാ ഫോം (One Single Box Application Form)
        =================================================================== -->
    <section id="apply-form" class="form-section-wrapper scroll-mt-24">
        <partial name="_ApplicationForm" model="Model" />
    </section>

</div>
