@using Microsoft.Extensions.Options
@using NedumkandomPublicLibrary.Options
@inject IOptions<LibraryOptions> LibraryOptions

@{
    var lib = LibraryOptions.Value;
}

<footer class="footer-container">
    <div class="footer-inner">
        
        <!-- Official Brand Logo & Location -->
        <div class="footer-brand-section">
            <div class="footer-logo-row">
                <div class="footer-logo-badge">
                    <img src="~/images/logo.png" alt="നെടുങ്കണ്ടം പബ്ലിക് ലൈബ്രറി ലോഗോ" width="40" height="40" class="footer-logo-img" />
                </div>
                <h3 class="footer-title">
                    @lib.Name
                </h3>
            </div>
            <p class="footer-location">
                @lib.Location
            </p>
        </div>

        <!-- Timings & Location Badges -->
        <div class="footer-badges-row">
            <div class="footer-badge">
                <svg class="footer-badge-icon text-emerald" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                    <circle cx="12" cy="10" r="3"/>
                </svg>
                <span>@lib.Location</span>
            </div>

            <div class="footer-badge">
                <svg class="footer-badge-icon text-amber" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 16 14"/>
                </svg>
                <span>പ്രവർത്തന സമയം: @lib.WeekdayHours</span>
            </div>
        </div>

        <!-- Contact / Call Button (Displays 'ബന്ധപ്പെടുക' and links to tel:9446823434) -->
        <div class="footer-call-wrapper">
            <a href="tel:@lib.Phone" class="footer-call-btn" aria-label="ഫോൺ വിളിക്കുക">
                <svg class="footer-call-icon" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <span>ബന്ധപ്പെടുക</span>
            </a>
        </div>

        <!-- Vision Quote & Copyright -->
        <div class="footer-copyright-section">
            <p class="footer-quote">
                “@lib.Vision”
            </p>
            <p class="footer-subtext">
                © @DateTime.Now.Year @lib.Name. @lib.SubTagline
            </p>
        </div>

    </div>
</footer>
