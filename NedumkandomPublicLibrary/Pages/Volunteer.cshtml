@page "/volunteer"
@model NedumkandomPublicLibrary.Pages.VolunteerModel
@{
    ViewData["Title"] = "സന്നദ്ധ പ്രവർത്തകർ (Volunteer) | നെടുങ്കണ്ടം പബ്ലിക് ലൈബ്രറി";
    var areas = new[]
    {
        "പുസ്തക ക്രമീകരണം",
        "കുട്ടികളുടെ പരിപാടികൾ",
        "ഡിജിറ്റൽ സഹായം",
        "വായനാ പരിപാടികൾ",
        "സാമൂഹിക പ്രവർത്തനങ്ങൾ",
        "സാംസ്കാരിക പരിപാടികൾ"
    };
}

<div class="max-w-4xl mx-auto py-10 px-4 space-y-8">
    <div class="text-center space-y-2 border-b border-slate-200 pb-6">
        <h1 class="text-3xl font-bold text-slate-900">സന്നദ്ധ പ്രവർത്തകർ (Volunteer)</h1>
        <p class="text-xs text-slate-600">
            ഗ്രന്ഥശാലയുടെ വിവിധ പ്രവർത്തനങ്ങളിൽ സന്നദ്ധ പ്രവർത്തകരെയും യുവാക്കളെയും പങ്കെടുപ്പിക്കാം.
        </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Info Column -->
        <div class="space-y-4">
            <h2 class="text-base font-bold text-[#0d5c46]">നിങ്ങൾക്കും സഹകരിക്കാം</h2>
            <div class="space-y-2">
                @foreach (var a in areas)
                {
                    <div class="flex items-center gap-2 text-xs font-semibold text-slate-800 bg-slate-50 p-2.5 rounded border border-slate-200">
                        <span class="text-emerald-600">❤️</span>
                        <span>@a</span>
                    </div>
                }
            </div>
        </div>

        <!-- Form Column -->
        <div class="lg:col-span-2">
            @if (Model.IsSubmitted)
            {
                <div class="custom-card p-6 text-center space-y-3 bg-emerald-50/50 border-emerald-200">
                    <span class="text-3xl text-[#0d5c46] mx-auto block">✓</span>
                    <h3 class="text-lg font-bold text-[#0d5c46]">അപേക്ഷ സ്വീകരിച്ചു!</h3>
                    <p class="text-xs text-slate-600">@Model.SuccessMessage</p>
                    <div class="text-xs font-mono font-bold text-slate-700">Ref: @Model.ReferenceId</div>
                    <div class="pt-3">
                        <a href="/volunteer" class="btn-secondary text-xs py-1.5 px-4">മറ്റൊരു രജിസ്ട്രേഷൻ നടത്തുക</a>
                    </div>
                </div>
            }
            else
            {
                <form method="post" class="custom-card p-6 space-y-4">
                    @Html.AntiForgeryToken()
                    <h2 class="text-base font-bold text-slate-900 border-b border-slate-100 pb-2">
                        [ Volunteer ആയി ചേരുക ]
                    </h2>

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="p-3 bg-red-50 border border-red-200 rounded text-xs text-red-700">
                            @Model.ErrorMessage
                        </div>
                    }

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">പേര് *</label>
                        <input type="text" asp-for="Form.Name" required placeholder="നിങ്ങളുടെ പേര്" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:ring-2 focus:ring-[#0d5c46]" />
                        <span asp-validation-for="Form.Name" class="text-xs text-red-600"></span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">മൊബൈൽ *</label>
                            <input type="tel" asp-for="Form.Mobile" required placeholder="10 അക്ക മൊബൈൽ" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:ring-2 focus:ring-[#0d5c46]" />
                            <span asp-validation-for="Form.Mobile" class="text-xs text-red-600"></span>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">Email</label>
                            <input type="email" asp-for="Form.Email" placeholder="email@example.com" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:ring-2 focus:ring-[#0d5c46]" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-2">താൽപ്പര്യമുള്ള മേഖലകൾ</label>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            @foreach (var area in areas)
                            {
                                <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer">
                                    <input type="checkbox" name="Form.AreaOfInterest" value="@area" class="rounded border-slate-300 text-[#0d5c46] focus:ring-[#0d5c46]" />
                                    <span>@area</span>
                                </label>
                            }
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">മുൻപരിചയം (ഉണ്ടെങ്കിൽ)</label>
                        <textarea rows="3" asp-for="Form.Experience" placeholder="മുൻപ് ചെയ്ത സന്നദ്ധ പ്രവർത്തനങ്ങൾ..." class="w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:ring-2 focus:ring-[#0d5c46]"></textarea>
                    </div>

                    <button type="submit" class="btn-primary w-full text-xs py-2.5">
                        [ സന്നദ്ധ സേവനത്തിനായി രജിസ്റ്റർ ചെയ്യുക ]
                    </button>
                </form>
            }
        </div>
    </div>
</div>
